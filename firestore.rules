rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the request is from a verified admin
    function isAdmin() {
      return request.auth != null &&
        (exists(/databases/$(database)/documents/admins/$(request.auth.token.email)) ||
         request.auth.token.email == 'wambuareggan@gmail.com');
    }

    // ── Public Collections (read-only) ──────────────────────────────────────

    match /sermons/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /ministries/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /leaders/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Restricted Collections ──────────────────────────────────────────────

    match /admins/{docId} {
      allow read, write: if isAdmin();
    }

    // FCM Tokens: code uses 'fcm_tokens' collection
    match /fcm_tokens/{docId} {
      allow read: if isAdmin();
      allow write: if true;
    }

    // Contact messages: code uses 'contact_messages' collection
    match /contact_messages/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    match /notifications/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Default: Deny all other access ──────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
