rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    
    // Function to check if a user is an admin
    function isAdmin() {
      return request.auth != null && 
        (firestore.exists(/databases/(default)/documents/admins/$(request.auth.token.email)) || 
         request.auth.token.email == 'wambuareggan@gmail.com');
    }

    // Public church assets: Read for all, Write for Admin
    match /assets/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Ministries Media: Public Read, Admin Write
    match /ministries/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default: Only Admins can manage storage
    match /{allPaths=**} {
      allow read, write: if isAdmin();
    }
  }
}
